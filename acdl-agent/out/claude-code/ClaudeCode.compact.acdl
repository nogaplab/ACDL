// ============================================================================
// Claude Code — context-assembly specification
//
// Scope: how the message array sent to the Anthropic Messages API is built. Every model call in this codebase funnels through queryModel(), which is the last place the array is touched before `anthropic.beta.messages.create`. The agentic loop that feeds it lives in queryLoop().
//
// Time model — MainAgent[@T.I]:
//   @T = one user turn. One call to query() per turn; the turn's messages are appended to a persistent array held in AppState / QueryEngine.
//   I  = one iteration of queryLoop's `while (true)` = one API call. Each completed sub-step appends the assistant message plus the merged tool-result user message.
//
// ROLE NOTE: this agent never emits a `tool`-role message. Tool results are user-role messages carrying `tool_result` content blocks — userMessageToMessageParam always returns role 'user', and only 'user' and 'assistant' reach the API. They are therefore written `U:` throughout, not `T:`.
//
// MERGE NOTE: normalizeMessagesForAPI merges consecutive user messages into one. Every `U: { ... }` below that lists several content elements is one API message produced by that merge.
//
// Source citations (file:line) for every element live in extraction-report.md; ClaudeCode.acdl is the annotated variant of this same spec.
// ============================================================================


// ----------------------------------------------------------------------------
// Content of one user-input message.
// Attachments are computed as separate internal messages *after* the prompt (processTextPrompt returns [userMessage, ...attachmentMessages]), then reorderAttachmentsForAPI bubbles them backwards past the plain user message until they hit an assistant / tool_result message — so in the array that reaches the API they precede the prompt text and merge with it into a single user message. Used by both the history loop and the current turn below.
// ----------------------------------------------------------------------------
StrFrag UserTurnInput[@t]: {
    // Computed from the raw input string: @-mentioned files, MCP resource mentions, @agent- mentions, turn-zero skill discovery.
    ForEach(att: sys.input_attachments[@t]) {
        att.content
    }
    // Thread-safe attachments, in source order: queued commands, date change, ultrathink, deferred-tools delta, agent-listing delta, MCP-instructions delta, changed files, nested memory, dynamic/listed skills, plan mode, todo reminders, teammate mailbox, team context, critical system reminder.
    ForEach(att: sys.thread_attachments[@t]) {
        att.content
    }
    // Main thread only, skipped when toolUseContext.agentId is set (i.e. inside a subagent): IDE selection / opened file, output style, diagnostics, LSP diagnostics, unified tasks, async hook responses, token usage, budget, verify-plan reminder.
    If (sys.is_main_thread == true) {
        ForEach(att: sys.main_thread_attachments[@t]) {
            att.content
        }
    }
    // UserPromptSubmit hook output, truncated to 10K chars by applyTruncation.
    ForEach(hook: sys.user_prompt_submit_hook_context[@t]) {
        hook.content
    }
    // The user's own text, last in the merged message. Pasted/attached images follow it in the same message.
    env.user_input[@t]
    ForEach(img: env.pasted_images[@t]) {
        img.block
    }
}


// ----------------------------------------------------------------------------
// One completed sub-step: the assistant message of one API response, plus the user message that the loop appended before re-entering. Used by the history loop and by the already-completed sub-steps of the current turn.
//
// A sub-step is one iteration of queryLoop's `while (true)`. It re-enters either because the model requested tools (the normal case) or because a recovery path fired. Both shapes are one assistant message followed by one user message, so they share this fragment.
// ----------------------------------------------------------------------------
RolesFrag ToolStep[@t, i]: {
    // One assistant message per API response; streamed blocks sharing a message id are merged.
    A: {
        // Thinking and text blocks, in the order the model streamed them.
        resp.content[@t.i]
        // Every parallel tool call of this sub-step lives in this same assistant message. Empty on a recovery step.
        ForEach(tool: sys.tool_requests[@t.i]) {
            tool.id_name_and_args
        }
    }
    Switch sys.step_outcome[@t.i] {
        // runTools yields one user message per tool result; they are then merged into one.
        Case tool_use: {
            U: {
                ForEach(tool: sys.tool_requests[@t.i]) {
                    // Micro-compaction and tool-result storage replace an older or oversized result in place by a fixed placeholder; the message itself is never removed.
                    If (sys.result_cleared[@t.i, tool] == true) {
                        TOOL_RESULT_CLEARED_PLACEHOLDER
                    }
                    Else {
                        tool.id_and_result
                    }
                }
                // Attachments recomputed after the tool batch: queued commands and task notifications drained mid-turn.
                ForEach(att: sys.mid_turn_attachments[@t.i]) {
                    att.content
                }
                // Relevant-memory prefetch, consumed on the first iteration where it has settled.
                ForEach(mem: sys.relevant_memories[@t.i]) {
                    mem.content
                }
                // Inter-turn skill-discovery prefetch.
                ForEach(skill: sys.discovered_skills[@t.i]) {
                    skill.content
                }
            }
        }
        // Output token limit hit; the truncated assistant message stays in the array and a resume nudge follows.
        Case max_output_tokens: {
            U: RESUME_AFTER_OUTPUT_LIMIT
        }
        // A Stop hook blocked the turn from ending; its reason text is appended.
        Case stop_hook_blocked: {
            U: sys.stop_hook_blocking_error[@t.i]
        }
        // Token-budget continuation nudge.
        Case token_budget: {
            U: TOKEN_BUDGET_NUDGE(sys.turn_output_tokens[@t.i])
        }
    }
}


// ============================================================================
// The main agent: REPL turn, SDK turn, and every subagent turn all run through query() -> queryLoop() -> queryModel().
// ============================================================================
MainAgent[@T.I]: {

    Mark 1 {
    // The whole system prompt is assembled here and passed as `system`. It is split into at most three text blocks — attribution header, CLI prefix, and everything else joined with "\n\n" — purely to place cache_control breakpoints. It is one logical system message.
    S: {
        // Billing/attribution header line; empty when disabled.
        ATTRIBUTION_HEADER(sys.entrypoint, sys.message_fingerprint[@T])
        // One of three fixed identity lines, chosen by interactive vs SDK vs SDK-with-append-prompt.
        CLI_SYSPROMPT_PREFIX
        // Exactly one of these four bodies, resolved in utils/systemPrompt.ts.
        Switch sys.system_prompt_source[@T] {
            Case coordinator: {
                COORDINATOR_SYSTEM_PROMPT
            }
            // A main-thread agent persona replaces the default prompt.
            Case agent: {
                sys.main_thread_agent_prompt
            }
            // --system-prompt / SDK systemPrompt suppresses the default build entirely.
            Case custom: {
                sys.custom_system_prompt
            }
            // The default build, in order.
            Default {
                // Identity + persona.
                INTRO_SECTION(sys.output_style)
                // Harness description.
                HARNESS_SECTION
                // Omitted when the active output style turns coding instructions off.
                If (sys.keep_coding_instructions == true) {
                    DOING_TASKS_SECTION
                }
                // Irreversible / outward-facing actions.
                ACTIONS_SECTION
                // Built from the enabled tool names.
                USING_YOUR_TOOLS_SECTION(sys.enabled_tool_names[@T])
                TONE_AND_STYLE_SECTION
                OUTPUT_EFFICIENCY_SECTION
                // Marker separating the globally cacheable prefix from per-user content.
                If (sys.global_cache_scope == true) {
                    DYNAMIC_BOUNDARY_MARKER
                }
                // Everything below is a registry-managed dynamic section, resolved in declaration order. Each may resolve to null and drop out.
                // Skills / subagent / session rules.
                SESSION_GUIDANCE_SECTION
                // Memory-directory mechanics + MEMORY.md.
                MEMORY_SECTION(sys.memory_dir)
                // cwd, platform, OS, model id, knowledge cutoff, additional working directories.
                ENV_INFO_SECTION(sys.cwd, sys.model_id, sys.additional_dirs)
                LANGUAGE_SECTION(sys.language_setting)
                OUTPUT_STYLE_SECTION(sys.output_style)
                // Concatenated instructions of every connected MCP server; skipped when the delta attachment carries them instead.
                If (sys.mcp_instructions_delta_enabled == false) {
                    MCP_SERVER_INSTRUCTIONS(sys.connected_mcp_servers[@T])
                }
                SCRATCHPAD_SECTION(sys.scratchpad_dir)
                // Function-result-clearing / compaction notice.
                CONTEXT_MANAGEMENT_SECTION
                SUMMARIZE_TOOL_RESULTS_SECTION
                // Present only under the token-budget build.
                TOKEN_BUDGET_SECTION
            }
        }
        // --append-system-prompt, plus everything main.tsx folds into it: chrome hints, custom agent instructions, proactive prompt.
        sys.append_system_prompt
        // systemContext, rendered as "key: value" lines and appended as the last block: git branch, main branch, user, short status (truncated at 2000 chars) and last 5 commits, snapshotted once at session start.
        ForEach(k: sys.system_context[@T]) {
            k.key_and_value
        }
        // Only when the server-side advisor tool is active.
        If (sys.advisor_enabled[@T] == true) {
            ADVISOR_TOOL_INSTRUCTIONS
        }
        // Only when Chrome MCP tools are present and tool search is on.
        If (sys.inject_chrome_instructions[@T] == true) {
            CHROME_TOOL_SEARCH_INSTRUCTIONS
        }
    }
    }

    Mark 2 {
    // Request preamble — two synthetic user messages prepended to the array at assembly time, in this order.
    // Ephemeral list of tools the model may load via ToolSearch; skipped when the persisted delta attachment is enabled.
    If (sys.tool_search_enabled[@T] == true & sys.deferred_tools_delta_enabled == false) {
        U: AVAILABLE_DEFERRED_TOOLS(sys.deferred_tool_names[@T])
    }
    // userContext, wrapped in a <system-reminder> block: CLAUDE.md / memory files, today's date, and the coordinator / scratchpad additions. Suppressed entirely when userContext is empty.
    If (sys.user_context[@T] != none) {
        U: USER_CONTEXT_REMINDER(sys.claude_md, sys.current_date, sys.coordinator_context)
    }
    }

    Mark 3 {
    // Compaction. The array is sliced at the last compact boundary, so everything before it is gone from the prompt. C is the turn at which that boundary was written; C = 0 when the conversation has never been compacted (findLastCompactBoundaryIndex returns -1).
    Name C := sys.last_compact_turn[@T]
    If (@$C > 0) {
        // The boundary marker itself is a `system` message and is filtered out before the API call — it never reaches the model.
        // The summary, wrapped in framing text that names the transcript path.
        U: {
            COMPACT_SUMMARY_FRAMING(sys.transcript_path)
            sys.conversation_summary[@$C]
        }
        // Post-compact restoration: recently-read files re-attached, async-agent notes, the current plan, plan-mode instructions, and PreCompact hook output. Partial compact additionally splices a preserved run of raw messages (messagesToKeep) in here — not modelled as separate roles, because which end is preserved depends on the compact direction.
        U: {
            ForEach(att: sys.post_compact_attachments[@$C]) {
                att.content
            }
        }
    }
    }

    Mark 4 {
    // Completed turns since the compact boundary. Each ran to a final assistant message with no tool_use block — that is the loop-exit condition.
    ForEach(t: range(@$C + 1, @T)) {
        U: {
            Frag UserTurnInput[@t]
        }
        // Every tool-using sub-step of that turn.
        ForEach(i: range(1, @t.substeps + 1)) {
            Frag ToolStep[@t, i]
        }
        // The final assistant message that ended the turn.
        A: resp.response[@t]
    }
    }

    Mark 5 {
    // The current turn. Input only — the model has not answered it yet. The user's message is appended and query() is called immediately.
    U: {
        Frag UserTurnInput[@T]
    }
    // Sub-steps of this turn that have already completed. Runs to I-1: sub-step I is the call being assembled right now, and its assistant message is exactly what this request will produce.
    ForEach(i: range(1, I)) {
        Frag ToolStep[@T, i]
    }
    // Nothing follows: the model writes the next assistant message.
    }
}


// ============================================================================
// Subagents (AgentTool / Task, teammates, forks).
//
// A subagent is NOT a different prompt shape — runAgent calls the same query() with the same loop, so everything in MainAgent's Mark 2-5 applies verbatim, with sys.is_main_thread false, which drops the main-thread attachment group. Only the system prompt and the seed messages differ, so only those are specified here.
// ============================================================================
SubAgent[@T.I, agent]: {

    Mark 1 {
    // Built by getAgentSystemPrompt. Note there is no getSystemPrompt() build here: a subagent does not inherit the main agent's tone / tools / session sections.
    S: {
        // The same two prefix lines as the main agent.
        ATTRIBUTION_HEADER(sys.entrypoint, sys.message_fingerprint[@T])
        CLI_SYSPROMPT_PREFIX
        // A fork inherits the parent's rendered system prompt byte-for-byte, for cache reuse.
        If (sys.is_fork[agent] == true) {
            sys.parent_system_prompt
        }
        Else {
            // The agent definition's own prompt body — built-in agent, .claude/agents/*.md, or plugin agent; DEFAULT_AGENT_PROMPT on failure.
            sys.agent_prompt[agent]
            // Fixed subagent notes: absolute paths, what to return, no emojis.
            SUBAGENT_NOTES
            If (sys.skill_search_enabled == true) {
                DISCOVER_SKILLS_GUIDANCE
            }
            // The same env block as the main agent, computed for the agent's own model.
            ENV_INFO_SECTION(sys.cwd, sys.agent_model[agent], sys.additional_dirs)
        }
        // Inherited from the parent.
        sys.append_system_prompt
        // gitStatus is dropped for the read-only Explore and Plan agents.
        If (sys.agent_type[agent] != explore & sys.agent_type[agent] != plan) {
            ForEach(k: sys.system_context[@T]) {
                k.key_and_value
            }
        }
    }
    }

    Mark 2 {
    // The same <system-reminder> preamble as the main agent, except that CLAUDE.md is dropped for agents whose definition sets omitClaudeMd (Explore, Plan).
    U: USER_CONTEXT_REMINDER(sys.claude_md, sys.current_date, sys.coordinator_context)
    }

    Mark 3 {
    // Seed messages — the subagent's turn 1 input.
    // Fork children only: the parent's entire conversation is replayed ahead of the task prompt, with incomplete tool calls filtered out by filterIncompleteToolCalls. Same shape as MainAgent Mark 4, but indexed over the PARENT's turns @p, not the child's.
    If (sys.is_fork[agent] == true) {
        ForEach(@p: range(1, sys.parent_turn_count[agent] + 1)) {
            U: {
                Frag UserTurnInput[@p]
            }
            ForEach(i: range(1, @p.substeps + 1)) {
                Frag ToolStep[@p, i]
            }
            A: resp.response[@p]
        }
    }
    U: {
        // The `prompt` argument of the tool call; buildForkedMessages for forks.
        env.task_prompt[agent]
        // Fork + worktree only.
        If (sys.has_worktree[agent] == true) {
            WORKTREE_PATH_NOTICE(sys.worktree_path[agent])
        }
    }
    // SubagentStart hook output.
    If (sys.subagent_start_hook_context[agent] != none) {
        U: sys.subagent_start_hook_context[agent]
    }
    // Skills named in the agent's frontmatter, each expanded into its own user message.
    ForEach(skill: sys.preloaded_skills[agent]) {
        U: {
            SKILL_LOADING_METADATA(skill.name)
            skill.content
        }
    }
    }

    // From here the loop is identical to MainAgent Mark 4-5 — runAgent enters the same queryLoop: completed turns, then the current turn's input and completed sub-steps.
}


// ============================================================================
// Compactor — the summarization call that produces the conversation summary consumed by MainAgent Mark 3.
// ============================================================================
Compactor[@T]: {

    // A single hard-coded line. Note that the main agent's system prompt is NOT reused here.
    S: SUMMARIZER_ROLE_LINE

    Mark 1 {
    // The conversation as the main loop would send it, after the last compact boundary, with all images stripped (stripImagesFromMessages) and reinjected attachments removed (stripReinjectedAttachments), then run through the same normalizeMessagesForAPI.
    // P comes from getMessagesAfterCompactBoundary; 0 if never compacted.
    Name P := sys.last_compact_turn[@T]
    ForEach(t: range(@$P + 1, @T)) {
        U: {
            Frag UserTurnInput[@t]
        }
        ForEach(i: range(1, @t.substeps + 1)) {
            Frag ToolStep[@t, i]
        }
        A: resp.response[@t]
    }
    // The newest turn may be incomplete. Autocompact fires from inside queryLoop after the turn's input has been appended but before its response exists; manual /compact runs between turns, where turn @T is already answered.
    U: {
        Frag UserTurnInput[@T]
    }
    ForEach(i: range(1, @T.substeps + 1)) {
        Frag ToolStep[@T, i]
    }
    If (sys.compact_trigger[@T] == manual) {
        A: resp.response[@T]
    }
    }

    Mark 2 {
    // The summarization instruction, appended as the final user message. getPartialCompactPrompt merges hook-supplied instructions and the user's /compact argument.
    U: {
        COMPACT_INSTRUCTIONS(sys.compact_direction[@T])
        If (sys.compact_custom_instructions[@T] != none) {
            sys.compact_custom_instructions[@T]
        }
    }
    // On prompt-too-long the call is retried with the head of the history dropped; the shape is otherwise unchanged.
    }
}


// ============================================================================
// Auxiliary single-shot queries.
//
// ~20 call sites (queryHaiku, sideQuery, queryModelWithoutStreaming) share one trivial shape: a fixed system prompt plus exactly one user message. They are specified once here rather than 20 times. Call sites are listed in the extraction report.
// ============================================================================
AuxQuery[task]: {
    S: {
        // Prepended unless the caller sets skipSystemPromptPrefix; queryHaiku goes through queryModel and always gets it.
        CLI_SYSPROMPT_PREFIX
        // The task's own fixed prompt.
        TASK_SYSTEM_PROMPT(task)
    }
    // Exactly one user message.
    U: env.task_input[task]
}
